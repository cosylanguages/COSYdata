{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosylanguages.github.io/COSYdata/schemas/vocabulary.quality.schema.json",
  "title": "Vocabulary Entry Quality Profile",
  "description": "Supplemental quality profile applied by scripts/quality-audit.cjs. Existing debt is recorded in reports/quality-baseline.json; new violations fail npm run quality.",
  "type": "object",
  "required": [
    "id",
    "word",
    "language",
    "form",
    "definitions",
    "examples"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}:[a-z0-9]+(?:-[a-z0-9]+)*:(noun|verb|adjective|adverb|phrase|idiom|preposition|pronoun|determiner|conjunction|interjection|expression|number|article|postposition|particle|phrasal_verb|prefix|suffix)$"
    },
    "word": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "form": {
      "type": "string",
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "phrase",
        "idiom",
        "preposition",
        "pronoun",
        "determiner",
        "conjunction",
        "interjection",
        "expression",
        "number",
        "article",
        "postposition",
        "particle",
        "phrasal_verb",
        "prefix",
        "suffix"
      ]
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "transcription": {
      "type": "string",
      "not": {
        "const": "-"
      }
    },
    "emoji": {
      "type": "string",
      "pattern": "^[^<>&\"']+$",
      "description": "Emoji or symbol that is safe to insert into HTML text context"
    }
  }
}
