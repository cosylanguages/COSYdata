{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosylanguages.github.io/COSYdata/schemas/vocabulary.schema.json",
  "title": "Vocabulary Entry",
  "description": "JSON Schema (draft 2020-12) for COSYdata vocabulary entries",
  "type": "object",
  "required": [
    "id",
    "word",
    "language",
    "form",
    "transcription"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}:[a-z0-9-]+:[a-z0-9-]+$",
      "description": "Identifier matching <language>:<word-slug>:<form>, e.g. en:healthy:adjective"
    },
    "word": {
      "type": "string",
      "description": "The target word or term"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "2-letter language code, e.g. en, es, fr"
    },
    "form": {
      "type": "string",
      "description": "Grammatical form or part of speech, e.g. noun, verb, adjective, adverb"
    },
    "level": {
      "type": "string",
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ],
      "description": "CEFR level"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A0",
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      },
      "minItems": 1,
      "description": "Array of all CEFR levels this word appears at across merged source entries"
    },
    "emoji": {
      "type": "string",
      "description": "Representative emoji string"
    },
    "transcription": {
      "type": "string",
      "description": "Primary or neutral IPA transcription"
    },
    "transcription_variants": {
      "type": "object",
      "properties": {
        "uk": {
          "type": "string",
          "description": "British English (RP) IPA transcription variant"
        },
        "us": {
          "type": "string",
          "description": "American English (General American) IPA transcription variant"
        },
        "ca": {
          "type": "string",
          "description": "Canadian English IPA transcription variant"
        },
        "au": {
          "type": "string",
          "description": "Australian English IPA transcription variant"
        },
        "nz": {
          "type": "string",
          "description": "New Zealand English IPA transcription variant"
        }
      },
      "additionalProperties": false,
      "description": "IPA pronunciation variants by dialect code"
    },
    "region": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "UK",
          "US",
          "CA",
          "AU",
          "NZ"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Region(s) where this specific word or spelling is preferred"
    },
    "regional_equivalents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}:[a-z0-9-]+:[a-z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Array of vocabulary IDs pointing to regional equivalent words"
    },
    "no_emoji": {
      "type": "boolean",
      "description": "Waives the required emoji constraint if true"
    },
    "no_antonym": {
      "type": "boolean",
      "description": "Waives the required antonyms constraint if true"
    },
    "audio": {
      "type": "string",
      "description": "Audio file path or URL"
    },
    "image": {
      "type": "string",
      "description": "Image file path or URL"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of definition strings (min 1 if present)"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of example usage strings"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of synonym terms or IDs"
    },
    "antonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of antonym terms or IDs"
    },
    "collocations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of common collocations"
    },
    "related_forms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of ID references into another COSY repo's data, e.g. COSYtools:fr-conjugeur:aimer"
    },
    "domain": {
      "type": "string",
      "description": "Subject domain"
    },
    "theme": {
      "type": "string",
      "description": "Primary theme"
    },
    "sub_theme": {
      "type": "string",
      "description": "Sub-theme"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of searchable tag strings"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "ISO date format string YYYY-MM-DD"
    },
    "article": {
      "type": "string",
      "description": "Grammatical article (meaningful for nouns)"
    },
    "gender": {
      "type": "string",
      "description": "Grammatical gender (meaningful for nouns)"
    },
    "countability": {
      "type": "string",
      "enum": [
        "countable",
        "uncountable",
        "pluralia_tantum",
        "invariable",
        "false_plural"
      ],
      "description": "Noun countability classification"
    },
    "plural_form": {
      "type": "string",
      "description": "Plural form (meaningful for nouns)"
    },
    "singular_workaround": {
      "type": "string",
      "description": "Countable phrase used to refer to one item for pluralia tantum nouns, e.g. a pair of scissors"
    },
    "collective_note": {
      "type": "string",
      "description": "Note for countable nouns whose verb agreement varies by dialect or reading"
    },
    "comparative": {
      "type": "string",
      "description": "Comparative form (meaningful for adjectives/adverbs)"
    },
    "superlative": {
      "type": "string",
      "description": "Superlative form (meaningful for adjectives/adverbs)"
    },
    "past_tense": {
      "type": "string",
      "description": "Simple past tense form (meaningful for verbs)"
    },
    "past_participle": {
      "type": "string",
      "description": "Past participle form (meaningful for verbs)"
    },
    "present_participle": {
      "type": "string",
      "description": "Present participle (-ing) form (meaningful for verbs)"
    },
    "is_irregular": {
      "type": "boolean",
      "description": "Indicates if past tense or past participle forms are irregular (meaningful for verbs)"
    },
    "prepositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "preposition",
          "example"
        ],
        "properties": {
          "preposition": {
            "type": "string",
            "description": "Preposition associated with the verb"
          },
          "example": {
            "type": "string",
            "description": "Example usage demonstrating the verb-preposition pattern"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Array of verb-preposition patterns with examples"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "no_emoji": {
            "const": true
          }
        },
        "required": [
          "no_emoji"
        ]
      },
      "else": {
        "required": [
          "emoji"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "no_antonym": {
            "const": true
          }
        },
        "required": [
          "no_antonym"
        ]
      },
      "else": {
        "required": [
          "antonyms"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "enum": [
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "required": [
          "synonyms"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "noun"
          }
        },
        "required": [
          "form"
        ]
      },
      "then": {
        "required": [
          "countability"
        ],
        "properties": {
          "article": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "countability": {
            "type": "string",
            "enum": [
              "countable",
              "uncountable",
              "pluralia_tantum",
              "invariable",
              "false_plural"
            ]
          },
          "plural_form": {
            "type": "string"
          },
          "singular_workaround": {
            "type": "string"
          },
          "collective_note": {
            "type": "string"
          },
          "comparative": false,
          "superlative": false,
          "past_tense": false,
          "past_participle": false,
          "present_participle": false,
          "is_irregular": false,
          "prepositions": false
        }
      },
      "else": {
        "properties": {
          "article": false,
          "gender": false,
          "countability": false,
          "plural_form": false,
          "singular_workaround": false,
          "collective_note": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "const": "verb"
          }
        },
        "required": [
          "form"
        ]
      },
      "then": {
        "properties": {
          "past_tense": {
            "type": "string"
          },
          "past_participle": {
            "type": "string"
          },
          "present_participle": {
            "type": "string"
          },
          "is_irregular": {
            "type": "boolean"
          },
          "prepositions": {
            "type": "array"
          }
        }
      },
      "else": {
        "properties": {
          "past_tense": false,
          "past_participle": false,
          "present_participle": false,
          "is_irregular": false,
          "prepositions": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_irregular": {
            "const": true
          }
        },
        "required": [
          "is_irregular"
        ]
      },
      "then": {
        "required": [
          "past_tense"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "form": {
            "enum": [
              "adjective",
              "adverb"
            ]
          }
        },
        "required": [
          "form"
        ]
      },
      "then": {
        "properties": {
          "comparative": {
            "type": "string"
          },
          "superlative": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "comparative": false,
          "superlative": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "countability": {
            "const": "countable"
          }
        },
        "required": [
          "countability"
        ]
      },
      "then": {
        "required": [
          "plural_form"
        ],
        "properties": {
          "singular_workaround": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "countability": {
            "const": "uncountable"
          }
        },
        "required": [
          "countability"
        ]
      },
      "then": {
        "properties": {
          "plural_form": false,
          "singular_workaround": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "countability": {
            "const": "pluralia_tantum"
          }
        },
        "required": [
          "countability"
        ]
      },
      "then": {
        "properties": {
          "plural_form": false,
          "singular_workaround": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "countability": {
            "const": "invariable"
          }
        },
        "required": [
          "countability"
        ]
      },
      "then": {
        "properties": {
          "plural_form": false,
          "singular_workaround": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "countability": {
            "const": "false_plural"
          }
        },
        "required": [
          "countability"
        ]
      },
      "then": {
        "properties": {
          "plural_form": false,
          "singular_workaround": false
        }
      }
    }
  ]
}