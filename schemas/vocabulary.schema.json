{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosylanguages.github.io/COSYdata/schemas/vocabulary.schema.json",
  "title": "Vocabulary Entry",
  "description": "JSON Schema (draft 2020-12) for COSYdata vocabulary entries",
  "type": "object",
  "required": [
    "id",
    "word",
    "language",
    "form",
    "transcription"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}:[a-z0-9-]+:[a-z0-9-]+$",
      "description": "Identifier matching <language>:<word-slug>:<form>, e.g. en:healthy:adjective"
    },
    "word": {
      "type": "string",
      "description": "The target word or term"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "2-letter language code, e.g. en, es, fr"
    },
    "form": {
      "type": "string",
      "description": "Grammatical form or part of speech, e.g. noun, verb, adjective, adverb"
    },
    "level": {
      "type": "string",
      "enum": [
        "A0",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ],
      "description": "CEFR level"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "A0",
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      },
      "minItems": 1,
      "description": "Array of all CEFR levels this word appears at across merged source entries"
    },
    "emoji": {
      "type": "string",
      "description": "Representative emoji string"
    },
    "transcription": {
      "type": "string",
      "description": "Primary or neutral IPA transcription"
    },
    "transcription_variants": {
      "type": "object",
      "properties": {
        "uk": {
          "type": "string",
          "description": "British English (RP) IPA transcription variant"
        },
        "us": {
          "type": "string",
          "description": "American English (General American) IPA transcription variant"
        },
        "ca": {
          "type": "string",
          "description": "Canadian English IPA transcription variant"
        },
        "au": {
          "type": "string",
          "description": "Australian English IPA transcription variant"
        },
        "nz": {
          "type": "string",
          "description": "New Zealand English IPA transcription variant"
        }
      },
      "additionalProperties": false,
      "description": "IPA pronunciation variants by dialect code"
    },
    "region": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "UK",
          "US",
          "CA",
          "AU",
          "NZ",
          "PT",
          "BR",
          "EA",
          "WA",
          "ES",
          "LATAM"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Region(s) where this specific word or spelling is preferred"
    },
    "regional_equivalents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}:[a-z0-9-]+:[a-z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Array of vocabulary IDs pointing to regional equivalent words"
    },
    "concept": {
      "type": "string",
      "pattern": "^en:[a-z0-9-]+:[a-z0-9-]+$",
      "description": "ID of the corresponding English concept entry"
    },
    "secondary_themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Secondary theme tags"
    },
    "sense": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Short slug distinguishing homographs"
    },
    "usage_note": {
      "type": "string",
      "description": "Short sentence of usage guidance in English"
    },
    "stress": {
      "type": "string",
      "description": "Headword with combining acute accent U+0301 on stressed vowel"
    },
    "harmony": {
      "type": "string",
      "enum": [
        "front",
        "back"
      ],
      "description": "Turkic vowel harmony class"
    },
    "no_emoji": {
      "type": "boolean",
      "description": "Waives the required emoji constraint if true"
    },
    "no_antonym": {
      "type": "boolean",
      "description": "Waives the required antonyms constraint if true"
    },
    "audio": {
      "type": "string",
      "description": "Audio file path or URL"
    },
    "image": {
      "type": "string",
      "description": "Image file path or URL"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of definition strings (min 1 if present)"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of example usage strings"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of synonym terms or IDs"
    },
    "antonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Array of antonym terms or IDs"
    },
    "collocations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of common collocations"
    },
    "related_forms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of ID references into another COSY repo's data, e.g. COSYtools:fr-conjugeur:aimer"
    },
    "grammar_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "manual_url"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "description": "Identifier for the governing grammar topic"
          },
          "manual_url": {
            "type": "string",
            "description": "URL to grammar manual documentation"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Array of grammar topic references governing this entry"
    },
    "domain": {
      "type": "string",
      "pattern": "^(general|travelling|travel|relocation|spoken|exam_preparation|exam|professional|general_adjectives)(, (general|travelling|travel|relocation|spoken|exam_preparation|exam|professional|general_adjectives))*$",
      "description": "Subject domain course tracks (single tag or comma-separated list, e.g. general, travelling, relocation, spoken, exam_preparation, professional)"
    },
    "scenario": {
      "type": "string",
      "description": "Short situational tag, e.g. airport check-in"
    },
    "register": {
      "type": "string",
      "enum": [
        "formal",
        "neutral",
        "informal"
      ],
      "description": "Register or tone of the word"
    },
    "exam_board": {
      "type": "string",
      "description": "Exam board or specification name, e.g. IELTS, TOEFL, DELF B2"
    },
    "exam_level": {
      "type": "string",
      "description": "Level or grade within the specific exam board if distinct from CEFR level"
    },
    "transliteration": {
      "type": "string",
      "description": "Latin-script rendering of the word for non-Latin script languages"
    },
    "theme": {
      "type": "string",
      "description": "Primary theme"
    },
    "sub_theme": {
      "type": "string",
      "description": "Sub-theme"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of searchable tag strings"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "ISO date format string YYYY-MM-DD"
    },
    "article": {
      "type": "string",
      "description": "Grammatical article (meaningful for nouns)"
    },
    "gender": {
      "type": "string",
      "description": "Grammatical gender (meaningful for nouns)"
    },
    "countability": {
      "type": "string",
      "enum": [
        "countable",
        "uncountable",
        "pluralia_tantum",
        "invariable",
        "false_plural"
      ],
      "description": "Noun countability classification"
    },
    "plural_form": {
      "type": "string",
      "description": "Plural form (meaningful for nouns and adjectives)"
    },
    "singular_workaround": {
      "type": "string",
      "description": "Countable phrase used to refer to one item for pluralia tantum nouns, e.g. a pair of scissors"
    },
    "collective_note": {
      "type": "string",
      "description": "Note for countable nouns whose verb agreement varies by dialect or reading"
    },
    "partitive": {
      "type": "string",
      "description": "Partitive article/form (e.g. du, de la, del)"
    },
    "h_aspire": {
      "type": "boolean",
      "description": "Indicates aspirate h in French"
    },
    "animacy": {
      "type": "string",
      "enum": [
        "animate",
        "inanimate"
      ],
      "description": "Grammatical animacy classification"
    },
    "definite_form": {
      "type": "string",
      "description": "Definite form of noun"
    },
    "genitive_singular": {
      "type": "string",
      "description": "Genitive singular form of noun"
    },
    "initial_mutations": {
      "type": "object",
      "properties": {
        "soft": {
          "type": "string"
        },
        "aspirate": {
          "type": "string"
        },
        "spirant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Initial mutation forms (e.g. for Celtic languages)"
    },
    "case_forms": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of grammatical case names to forms"
    },
    "auxiliary": {
      "type": "string",
      "description": "Auxiliary verb used in compound tenses"
    },
    "conjugation_class": {
      "type": "string",
      "description": "Verb conjugation class or paradigm"
    },
    "stem_change": {
      "type": "string",
      "description": "Stem change specification"
    },
    "separable_prefix": {
      "type": "string",
      "description": "Separable verb prefix"
    },
    "reflexive": {
      "type": "boolean",
      "description": "Indicates reflexive verb"
    },
    "aspect": {
      "type": "string",
      "enum": [
        "imperfective",
        "perfective",
        "biaspectual",
        "stative",
        "action",
        "both"
      ],
      "description": "Verbal aspect"
    },
    "aspect_pair": {
      "type": "string",
      "description": "Opposite aspect verb ID or form"
    },
    "motion_type": {
      "type": "string",
      "enum": [
        "unidirectional",
        "multidirectional"
      ],
      "description": "Type of verb of motion"
    },
    "voice": {
      "type": "string",
      "enum": [
        "active",
        "passive",
        "deponent"
      ],
      "description": "Grammatical voice"
    },
    "present_forms": {
      "type": "object",
      "properties": {
        "sg1": {
          "type": "string"
        },
        "sg2": {
          "type": "string"
        },
        "sg3": {
          "type": "string"
        },
        "sg3m": {
          "type": "string"
        },
        "sg3f": {
          "type": "string"
        },
        "pl1": {
          "type": "string"
        },
        "pl2": {
          "type": "string"
        },
        "pl3": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Present tense conjugation forms"
    },
    "person_forms": {
      "type": "object",
      "properties": {
        "sg1": {
          "type": "string"
        },
        "sg2": {
          "type": "string"
        },
        "sg3": {
          "type": "string"
        },
        "sg3m": {
          "type": "string"
        },
        "sg3f": {
          "type": "string"
        },
        "pl1": {
          "type": "string"
        },
        "pl2": {
          "type": "string"
        },
        "pl3": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Inflected person forms for conjugated prepositions"
    },
    "stems": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Verb stem variants"
    },
    "negative_form": {
      "type": "string",
      "description": "Negative form of verb"
    },
    "feminine": {
      "type": "string",
      "description": "Feminine form of adjective"
    },
    "neuter": {
      "type": "string",
      "description": "Neuter form of adjective"
    },
    "masculine_plural": {
      "type": "string",
      "description": "Masculine plural form of adjective"
    },
    "feminine_plural": {
      "type": "string",
      "description": "Feminine plural form of adjective"
    },
    "position": {
      "type": "string",
      "enum": [
        "before_noun",
        "after_noun",
        "either"
      ],
      "description": "Position relative to noun for adjectives"
    },
    "person": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "description": "Grammatical person (1, 2, or 3)"
    },
    "number": {
      "type": "string",
      "enum": [
        "singular",
        "plural"
      ],
      "description": "Grammatical number"
    },
    "governs_case": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ],
      "description": "Grammatical case(s) governed by preposition or postposition"
    },
    "value": {
      "type": "integer",
      "description": "Numeric integer value for number forms"
    },
    "comparative": {
      "type": "string",
      "description": "Comparative form (meaningful for adjectives/adverbs)"
    },
    "superlative": {
      "type": "string",
      "description": "Superlative form (meaningful for adjectives/adverbs)"
    },
    "past_tense": {
      "type": "string",
      "description": "Simple past tense form (meaningful for verbs)"
    },
    "past_participle": {
      "type": "string",
      "description": "Past participle form (meaningful for verbs)"
    },
    "present_participle": {
      "type": "string",
      "description": "Present participle (-ing) form (meaningful for verbs)"
    },
    "is_irregular": {
      "type": "boolean",
      "description": "Indicates if verb is irregular"
    },
    "prepositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "preposition",
          "example"
        ],
        "properties": {
          "preposition": {
            "type": "string",
            "description": "Preposition associated with the verb"
          },
          "example": {
            "type": "string",
            "description": "Example usage demonstrating the verb-preposition pattern"
          },
          "case": {
            "type": "string",
            "description": "Grammatical case governed by the preposition in this pattern"
          },
          "usage": {
            "type": "string",
            "description": "Usage context or meaning nuance for this preposition pattern"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Array of verb-preposition patterns with examples"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "no_emoji": {
            "const": true
          }
        },
        "required": [
          "no_emoji"
        ]
      },
      "else": {
        "required": [
          "emoji"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "no_antonym": {
            "const": true
          }
        },
        "required": [
          "no_antonym"
        ]
      },
      "else": {
        "required": [
          "antonyms"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "enum": [
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "required": [
          "synonyms"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "secondary_themes": {
            "type": "array"
          }
        },
        "required": [
          "secondary_themes"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "actions"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "actions"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "activities"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "activities"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "animals"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "animals"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "clothing"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "clothing"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "colors"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "colors"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "communication"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "communication"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "descriptors"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "descriptors"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "education"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "education"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "emotions"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "emotions"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "family"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "family"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "food"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "food"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "general"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "general"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "geography"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "geography"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "grammar"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "grammar"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "health"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "health"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "theme": {
                  "const": "housing"
                }
              },
              "required": [
                "theme"
              ]
            },
            "then": {
              "properties": {
                "secondary_themes": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "const": "housing"
                    }
                  }
                }
              }
            }
          },
          {
