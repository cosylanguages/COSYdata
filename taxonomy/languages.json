    {
      "field": "standards",
      "meaning": "standard varieties to teach (e.g. Eastern/Western Armenian; European/Brazilian Portuguese)"
    },
    {
      "field": "gender",
      "meaning": "none / 2 / 3 / noun classes"
    },
    {
      "field": "case_count",
      "meaning": "number of cases or 'none'"
    },
    {
      "field": "morphology",
      "meaning": "isolating / fusional / agglutinative / polysynthetic / templatic"
    },
    {
      "field": "verb_system",
      "meaning": "aspect-prominent / tense-prominent / evidential / polypersonal"
    },
    {
      "field": "word_order",
      "meaning": "SVO / SOV / VSO / free + notes"
    },
    {
      "field": "phonology_flags",
      "meaning": "tone, vowel harmony, mutations, pharyngeals, ejectives"
    },
    {
      "field": "politeness",
      "meaning": "T–V, honorific levels, none"
    },
    {
      "field": "reference_docs",
      "meaning": "CoE RLD, national standards, textbook syllabi"
    },
    {
      "field": "exams",
      "meaning": "exam name, level range, validity, issuer, verified_date"
    },
    {
      "field": "optional_modules",
      "meaning": "list of G15–G20 modules to enable"
    },
    {
      "field": "overrides",
