  "insights": [
    {
      "id": "weekday-counting",
      "concepts": [
        "weekday.monday",
        "weekday.tuesday",
        "weekday.wednesday",
        "weekday.thursday"
      ],
      "text": "Greek, Portuguese, Armenian and Georgian count the days from Sunday, so Monday is 'second'. Russian counts from Monday, so вторник (Tuesday) is 'second'.",
      "reviewed": false
    },
    {
      "id": "weekday-persian",
      "concepts": [
        "weekday.monday",
        "weekday.tuesday",
        "weekday.wednesday",
        "weekday.sunday"
      ],
      "text": "Tatar and Bashkir weekday names are Persian numbers + shanbe: dū-shanbe (2), se-shanbe (3), chahār-shanbe (4), yek-shanbe (1).",
      "reviewed": false
    },
    {
      "id": "weekday-gods",
      "concepts": [
        "weekday.tuesday",
        "weekday.wednesday",
        "weekday.thursday",
        "weekday.friday"
      ],
      "text": "English Tuesday to Friday translate the Latin planetary-god names into Germanic gods: Mars = Tiw, Mercury = Woden, Jupiter = Thor, Venus = Frige.",
      "reviewed": false
    },
    {
      "id": "month-numbers",
      "concepts": [
        "month.september",
        "month.october",
        "month.november",
        "month.december"
      ],
      "text": "September, October, November and December come from the Latin numbers 7, 8, 9 and 10, although they are now the 9th to 12th months.",
      "reviewed": false
    },
    {
      "id": "breton-meurzh",
      "concepts": [
        "weekday.tuesday",
        "month.march"
      ],
      "text": "In Breton, meurzh means both Tuesday and March: both come from Latin Martis (of Mars).",
      "reviewed": false
    }
  ],
