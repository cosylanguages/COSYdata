{
  "name": "cosydata",
  "version": "0.1.0",
  "description": "Canonical static data repository for the COSYlanguages ecosystem",
  "type": "module",
  "types": "shared/types.d.ts",
  "scripts": {
    "audit": "node scripts/audit-a0-a1.cjs",
    "build": "npm run build:pages && npm run build:index && npm run build:flat-index && npm run build:search-index && npm run build:daily && npm run build:comparative && npm run build:stats && npm run build:relations && npm run build:quality-report",
    "build:daily": "node scripts/build-daily-calendar.cjs",
    "build:index": "node scripts/build-index.cjs",
    "build:flat-index": "node scripts/build-flat-index.js",
    "build:search-index": "node scripts/build-search-index.js",
    "import:events": "node scripts/import-events-vocab.cjs",
    "parity": "node scripts/a0-a1-parity.cjs",
    "normalize:themes": "node scripts/normalize-vocabulary-themes.cjs",
    "backfill:form-themes": "node scripts/backfill-form-themes.cjs",
    "fix:theme-mismatches": "node scripts/fix-theme-mismatches.cjs",
    "sync:shared-themes": "node scripts/sync-shared-themes.cjs",
    "validate": "node scripts/validate.cjs && node scripts/validate-theme-normalisation.cjs && node scripts/validate-theme-taxonomy-sync.cjs && node scripts/validate-confusion-pairs.cjs && node scripts/quality-audit.cjs --check && node scripts/check-no-cross-repo-assets.cjs && node scripts/sync-ecosystem-assets.cjs --check && node scripts/build-pages.cjs --check && node scripts/build-relations.cjs --check && node scripts/build-conjugation-registry.mjs --check && node scripts/build-quality-report.cjs --check",
    "quality": "node scripts/quality-audit.cjs --check",
    "quality:update-baseline": "node scripts/quality-audit.cjs --update-baseline",
    "validate:themes": "node scripts/validate-theme-normalisation.cjs",
    "validate:theme-sync": "node scripts/validate-theme-taxonomy-sync.cjs",
    "test:verb-inventory": "node scripts/validate-verb-inventory.cjs",
    "test:quality": "node --test tests/quality-audit.test.mjs",
    "test:integrity": "node --test tests/data-integrity.test.mjs",
    "test:parity": "node --test tests/parity-recursion.test.mjs",
    "build:comparative": "node scripts/build-comparative.cjs",
    "build:conjugation": "node scripts/build-conjugation-registry.mjs",
    "test:conjugation": "node --test tests/conjugation-embed.test.mjs",
    "test:independence": "node --test tests/independence.test.mjs",
    "sync:ecosystem-assets": "node scripts/sync-ecosystem-assets.cjs --update",
    "check:ecosystem-assets": "node scripts/sync-ecosystem-assets.cjs --check",
    "check:independence": "node scripts/check-no-cross-repo-assets.cjs",
    "build:pair-coverage": "node scripts/build-confusion-pair-coverage.cjs",
    "build:stats": "node scripts/build-stats.cjs",
    "check:stats": "node scripts/build-stats.cjs --check",
    "test:stats": "node --test tests/stats.test.mjs",
    "build:pages": "node scripts/build-pages.cjs",
    "check:pages": "node scripts/build-pages.cjs --check",
    "test:pages": "node --test tests/pages.test.mjs",
    "test:dictionary": "node --test tests/dictionary-ui.test.mjs",
    "build:relations": "node scripts/build-relations.cjs",
    "check:relations": "node scripts/build-relations.cjs --check",
    "test:relations": "node --test tests/relations.test.mjs",
    "check:conjugation": "node scripts/build-conjugation-registry.mjs --check",
    "build:quality-report": "node scripts/build-quality-report.cjs",
    "check:quality-report": "node scripts/build-quality-report.cjs --check",
    "test:validator": "node --test tests/validator.test.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "playwright": "^1.65.1"
  }
}
